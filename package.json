{
  "name": "vite-plugin-flatten-output",
  "version": "0.1.0",
  "description": "Flatten nested HTML build output while preserving asset URLs.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "homepage": "https://myudak.site/projects/vite-plugin-flatten-output",
  "repository": {
    "type": "git",
    "url": "https://github.com/myudak/vite-plugin-flatten-output.git"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/build-types.mjs",
    "release:version": "changeset version && pnpm install --no-frozen-lockfile",
    "release:publish": "pnpm run build && changeset publish",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 tests/build.test.mjs tests/html.test.mjs",
    "test:browser": "npm run build && node --test --test-concurrency=1 tests/browser.mjs",
    "test:compat": "node scripts/compat.mjs",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "vite",
    "vite-plugin",
    "file-structure",
    "flatten-output",
    "vite-output-plugin",
    "vite-chrome-extension"
  ],
  "author": "hi@myudak.site",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "tsup": "^8.0.2",
    "typescript": "^5.4.2",
    "@types/node": "^22.10.5",
    "@types/parse-srcset": "^1.0.0",
    "playwright": "1.64.1",
    "vite": "8.3.5",
    "npm": "11.9.0"
  },
  "peerDependencies": {
    "vite": "^5.1.0 || ^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "parse5": "^7.3.0",
    "parse-srcset": "^1.0.2",
    "postcss-value-parser": "^4.2.0"
  },
  "packageManager": "pnpm@9.15.9"
}
